  - name: Post PR comment
    uses: actions/github-script@v7
    with:
      script: |
        const routeResults = `${{ steps.route-checks.outputs.results }}`;
        const formFound = ${{ steps.form-check.outputs.form_found }};
        const allPass = ${{ steps.route-checks.outputs.all_pass }};
        
        const formStatus = formFound ? 'Found' : 'Not Found';
        const overallStatus = (allPass && formFound) ? 'PASS' : 'FAIL';
        
        const body = `## OC Gate Validation Results
        
        **Overall Status:** ${overallStatus}
        
        ### Route Checks
        ${routeResults}
        
        ### Subscribe Form Check
        | Check | Status |
        |-------|--------|
        | Subscribe form on /arlington | ${formStatus} |
        `;
        
        github.rest.issues.createComment({
          issue_number: context.issue.number,
          owner: context.repo.owner,
          repo: context.repo.repo,
          body: body
        });

  - name: Add label based on result
    if: always()
    uses: actions/github-script@v7
    with:
      script: |
        const allPass = ${{ steps.route-checks.outputs.all_pass }};
        const formFound = ${{ steps.form-check.outputs.form_found }};
        const label = (allPass && formFound) ? 'oc-approved' : 'oc-blocked';
        
        github.rest.issues.addLabels({
          issue_number: context.issue.number,
          owner: context.repo.owner,
          repo: context.repo.repo,
          labels: [label]
        });

  - name: Auto-merge if passed
    if: steps.route-checks.outputs.all_pass == 'true' && steps.form-check.outputs.form_found == 'true'
    uses: actions/github-script@v7
    with:
      script: |
        github.rest.pulls.merge({
          pull_number: context.issue.number,
          owner: context.repo.owner,
          repo: context.repo.repo,
          merge_method: 'squash'
        });

  - name: Send failure email
    if: failure() || steps.route-checks.outputs.all_pass != 'true' || steps.form-check.outputs.form_found != 'true'
    uses: dawidd6/action-send-mail@v3
    with:
      server_address: ${{ secrets.SMTP_HOST }}
      server_port: ${{ secrets.SMTP_PORT }}
      username: ${{ secrets.SMTP_USER }}
      password: ${{ secrets.SMTP_PASS }}
      subject: OC Gate FAILED — ${{ github.event.pull_request.title }}
      to: ${{ secrets.NOTIFY_EMAIL }}
      from: ${{ secrets.SMTP_USER }}
      body: |
        OC Gate validation failed for PR: ${{ github.event.pull_request.title }}
        
        PR URL: ${{ github.event.pull_request.html_url }}
        Branch: ${{ github.head_ref }}
        
        Please check the GitHub Actions logs for details.
