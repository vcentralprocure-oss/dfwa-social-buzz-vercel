  - name: Check for backup branch
    id: check-backup
    run: |
      echo "Checking for backup branch..."
      BACKUP_BRANCHES=$(git branch -r | grep -E 'backup/|backup-' | wc -l)
      if [ "$BACKUP_BRANCHES" -eq 0 ]; then
        echo "WARNING: No backup branch found in repository"
        echo "backup_exists=false" >> $GITHUB_OUTPUT
      else
        echo "Backup branch(s) found: $BACKUP_BRANCHES"
        echo "backup_exists=true" >> $GITHUB_OUTPUT
      fi

  - name: Pause if no backup branch
    if: steps.check-backup.outputs.backup_exists == 'false'
    run: |
      echo "STANDING RULE VIOLATION: No backup branch exists"
      echo "Task that modifies main branch cannot proceed without backup"
      echo "Please create a backup branch before continuing"
      exit 1

