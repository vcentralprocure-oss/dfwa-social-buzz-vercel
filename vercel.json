{
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home-render"
    },
    {
      "source": "/articles",
      "destination": "/articles/index.html"
    },
    {
      "source": "/articles/",
      "destination": "/articles/index.html"
    },
    {
      "source": "/articles/:slug",
      "destination": "/articles/:slug.html"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/api/home-render"
    }
  ]
}
