<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>This Weekend in Arlington: Your Guide to May 30-June 1, 2026 | Arlington Pulse</title>
    <meta name="description" content="From Taste Community Restaurant's summer menu launch to Texas Rangers Barbie Night, discover the best events and activities happening in Arlington this weekend.">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0a14; color: white; line-height: 1.6; }
        
        /* Header */
        .top-header { background: #0a0a0a; padding: 0.75rem 2rem; border-bottom: 1px solid #222; }
        .top-header-content { max-width: 1400px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }
        .logo-section { display: flex; align-items: center; gap: 0.75rem; }
        .logo-section .logo-img { width: 36px; height: 36px; background: linear-gradient(135deg, #FF6B35 0%, #e55a2b 100%); border-radius: 6px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1rem; }
        .logo-section .logo-text { color: white; }
        .logo-section .logo-text .main { font-weight: 700; font-size: 1rem; color: #FF6B35; }
        .logo-section .logo-text .sub { font-size: 0.7rem; color: #888; }
        .main-nav { display: flex; align-items: center; gap: 2rem; }
        .main-nav .nav-links { display: flex; gap: 1.5rem; }
        .main-nav .nav-links a { color: #aaa; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
        .main-nav .nav-links a:hover { color: #FF6B35; }
        .city-nav { display: flex; gap: 0.5rem; }
        .city-nav a { color: #aaa; text-decoration: none; padding: 5px 12px; border-radius: 4px; font-size: 0.8rem; transition: all 0.2s; }
        .city-nav a:hover { background: rgba(255,107,53,0.1); color: #FF6B35; }
        .city-nav a.active { background: #FF6B35; color: white; }
        
        /* Article Styles */
        .article-container { max-width: 800px; margin: 0 auto; padding: 3rem 2rem; }
        .article-header { margin-bottom: 2rem; }
        .article-category { color: #FF6B35; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
        .article-title { font-size: 2.5rem; font-weight: 700; line-height: 1.2; margin-bottom: 1rem; }
        .article-meta { color: #888; font-size: 0.9rem; margin-bottom: 1.5rem; }
        .article-meta span { margin-right: 1.5rem; }
        
        .featured-image { width: 100%; height: 450px; object-fit: cover; border-radius: 12px; margin-bottom: 2rem; }
        .image-caption { color: #666; font-size: 0.85rem; text-align: center; margin-top: -1.5rem; margin-bottom: 2rem; }
        
        .article-content { font-size: 1.1rem; line-height: 1.8; color: #ddd; }
        .article-content p { margin-bottom: 1.5rem; }
        .article-content h2 { font-size: 1.5rem; color: #FF6B35; margin: 2.5rem 0 1rem; }
        .article-content h3 { font-size: 1.2rem; color: #fff; margin: 2rem 0 0.75rem; }
        .article-content ul { margin-bottom: 1.5rem; padding-left: 1.5rem; }
        .article-content li { margin-bottom: 0.5rem; }
        .article-content a { color: #FF6B35; text-decoration: none; }
        .article-content a:hover { text-decoration: underline; }
        
        .business-highlight { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 1px solid #333; border-radius: 12px; padding: 1.5rem; margin: 2rem 0; }
        .business-highlight h4 { color: #FF6B35; margin-bottom: 0.5rem; }
        .business-highlight p { margin-bottom: 0.75rem; font-size: 1rem; }
        .business-highlight a { color: #FF6B35; font-weight: 600; }
        
        /* CTA Boxes */
        .cta-box { background: linear-gradient(135deg, #FF6B35 0%, #e55a2b 100%); border-radius: 12px; padding: 2rem; text-align: center; margin: 2.5rem 0; }
        .cta-box h3 { color: white; font-size: 1.5rem; margin-bottom: 0.75rem; }
        .cta-box p { color: rgba(255,255,255,0.9); margin-bottom: 1.25rem; }
        .cta-box .btn { background: white; color: #FF6B35; padding: 14px 32px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block; }
        .cta-box .btn:hover { background: #f0f0f0; }
        
        .subscribe-box { background: #111122; border: 2px solid #FF6B35; border-radius: 12px; padding: 2rem; text-align: center; margin: 2.5rem 0; }
        .subscribe-box h3 { color: #FF6B35; margin-bottom: 0.75rem; }
        .subscribe-box p { color: #888; margin-bottom: 1.25rem; }
        .subscribe-box .btn { background: #FF6B35; color: white; padding: 14px 32px; text-decoration: none; border-radius: 6px; font-weight: 600; display: inline-block; }
        
        /* Internal Links Section */
        .related-articles { background: #111122; border-radius: 12px; padding: 2rem; margin: 3rem 0; }
        .related-articles h3 { color: #FF6B35; margin-bottom: 1.5rem; font-size: 1.3rem; }
        .related-articles ul { list-style: none; padding: 0; }
        .related-articles li { margin-bottom: 1rem; padding-left: 1.5rem; position: relative; }
        .related-articles li::before { content: "→"; position: absolute; left: 0; color: #FF6B35; }
        .related-articles a { color: #ddd; text-decoration: none; }
        .related-articles a:hover { color: #FF6B35; }
        
        /* Footer */
        .main-footer { background: #0a0a0a; padding: 3rem 2rem 1.5rem; border-top: 2px solid #FF6B35; margin-top: 4rem; }
        .footer-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem; }
        .footer-brand .logo-text { color: #FF6B35; font-weight: 700; font-size: 1.3rem; margin-bottom: 0.5rem; }
        .footer-brand .tagline { color: #888; font-size: 0.9rem; margin-bottom: 1rem; }
        .footer-links h4 { color: #FF6B35; font-size: 0.9rem; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px; }
        .footer-links ul { list-style: none; }
        .footer-links li { margin-bottom: 0.5rem; }
        .footer-links a { color: #888; text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
        .footer-links a:hover { color: #FF6B35; }
        .footer-bottom { text-align: center; padding-top: 2rem; margin-top: 2rem; border-top: 1px solid #222; color: #666; font-size: 0.8rem; }
        
        @media (max-width: 768px) {
            .article-title { font-size: 1.8rem; }
            .featured-image { height: 250px; }
            .footer-content { grid-template-columns: 1fr; }
            .top-header-content { flex-direction: column; gap: 0.75rem; }
        }
    </style>
</head>
